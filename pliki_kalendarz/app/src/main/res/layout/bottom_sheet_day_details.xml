<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- Date Title -->
    <TextView
        android:id="@+id/tvSheetDateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15 Październik 2026"
        android:textColor="#00695C"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Parallel Dates Summary Row -->
    <TextView
        android:id="@+id/tvSheetParallelDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hijri: 4 Rabi' II 1448 | Żydowski: 4 Tishrei 5787"
        android:textColor="#666666"
        android:textSize="12sp" />

    <!-- Section: Święta Państwowe i Religijne -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Święta Międzynarodowe &amp; Państwowe"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/containerHolidays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <!-- Section: Twoje Wydarzenia -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Wydarzenia Użytkownika"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/containerUserEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddEventForDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="+ Dodaj Nowe Wydarzenie"
        app:backgroundTint="#00695C" />

</LinearLayout>
